FROM debian:sid

# nginxをインストールする
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    nginx \
    && rm -rf /var/lib/apt/lists/*

# nginxのデフォルトドキュメントを差し替える
RUN echo '<!doctype html><html><body><h1>Hello from Docker + nginx</h1></body></html>' \
    > /var/www/html/index.html

# ポートを公開する
EXPOSE 80

# nginxを実行する
ENTRYPOINT ["nginx"]

# Dockerで動作させるためにフォアグラウンド実行する
CMD ["-g", "daemon off;"]
